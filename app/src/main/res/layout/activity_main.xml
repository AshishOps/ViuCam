<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/bg_chassis"
    android:padding="12dp"
    android:baselineAligned="false">

    <!-- Left Stage: 16:9 Broadcast Viewfinder + Subtle HUD -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.45"
        android:paddingEnd="12dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:cardCornerRadius="16dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/border_hairline"
            app:cardBackgroundColor="#000000"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintDimensionRatio="H,16:9">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.camera.view.PreviewView
                    android:id="@+id/viewFinder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:scaleType="fitCenter" />

                <!-- Top-Left Viewfinder Telemetry Pill -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#B30A0B0D"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp">

                    <TextView
                        android:id="@+id/tvLiveBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LIVE"
                        android:textColor="@color/rec_red"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@color/rec_red_soft"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp" />

                    <TextView
                        android:id="@+id/tvStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="1280x720"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <!-- Bottom-Left Stream URL Bar -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#CC0A0B0D"
                    android:paddingStart="10dp"
                    android:paddingEnd="4dp"
                    android:paddingVertical="4dp">

                    <TextView
                        android:id="@+id/tvWifiUrl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="http://192.168.1.100:8080/video"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:fontFamily="monospace" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopyWifiUrl"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="8dp"
                        android:layout_marginStart="4dp"
                        android:text="Copy"
                        android:textColor="@color/accent_cobalt"
                        android:textSize="12sp"
                        app:icon="@drawable/ic_copy"
                        app:iconTint="@color/accent_cobalt"
                        app:iconSize="14dp"
                        app:iconPadding="4dp" />
                </LinearLayout>

                <!-- Dim Overlay when dim mode is activated -->
                <View
                    android:id="@+id/dimOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#F0000000"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvDimNotice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Screen dimmed — tap to wake"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Right Control Deck: Clean Studio Console -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.9"
        android:orientation="vertical"
        android:background="@color/surface_panel"
        android:padding="14dp">

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUsbGuide"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="USB"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:strokeColor="@color/border_hairline"
                app:icon="@drawable/ic_usb"
                app:iconTint="@color/text_primary"
                app:iconSize="15dp"
                app:iconPadding="4dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_hairline" />

        <!-- Resolution Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="6dp"
            android:text="Resolution"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleResolution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRes4k"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:paddingHorizontal="2dp"
                android:text="4K"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:strokeColor="@color/border_hairline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRes1080p"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:paddingHorizontal="2dp"
                android:text="1080p"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:strokeColor="@color/border_hairline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRes720p"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:paddingHorizontal="2dp"
                android:text="720p"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:strokeColor="@color/border_hairline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRes480p"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:paddingHorizontal="2dp"
                android:text="480p"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:strokeColor="@color/border_hairline" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Wi-Fi Latency / Compression Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="6dp"
            android:text="Wi-Fi quality"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleQuality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQualFast"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:paddingHorizontal="2dp"
                android:text="Fast"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:strokeColor="@color/border_hairline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQualBalanced"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:paddingHorizontal="2dp"
                android:text="Balanced"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:strokeColor="@color/border_hairline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQualSharp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:paddingHorizontal="2dp"
                android:text="Sharp"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:strokeColor="@color/border_hairline" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Camera Hardware Controls -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Camera controls"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSwitchCamera"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:paddingHorizontal="4dp"
                android:text="Flip"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:backgroundTint="@color/surface_control"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_flip_camera"
                app:iconTint="@color/text_primary"
                app:iconSize="16dp"
                app:iconPadding="4dp" />

            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleTorch"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:paddingHorizontal="4dp"
                android:text="Flash"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:backgroundTint="@color/surface_control"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_flash"
                app:iconTint="@color/text_primary"
                app:iconSize="16dp"
                app:iconPadding="4dp" />

            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDimScreen"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:paddingHorizontal="4dp"
                android:text="Dim"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:backgroundTint="@color/surface_control"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_dim_screen"
                app:iconTint="@color/text_primary"
                app:iconSize="16dp"
                app:iconPadding="4dp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
